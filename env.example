# Required

# GitHub personal access token (needs repo, issues, pull_requests scopes)
GITHUB_TOKEN=ghp_your_token_here

# Groq API key (free tier works fine — https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_key_here

# Optional

# OpenAI key — if set, Mem0 uses semantic embeddings for smarter memory search
# OPENAI_API_KEY=sk-...

# Override the MCP server URL (default: http://localhost:8001/sse)
# MCP_SERVER_URL=http://localhost:8001/sse

# Service Ports (defaults shown)
# Main FastAPI app: http://localhost:8000
# MCP tool server:  http://localhost:8001
