# Required
GITHUB_TOKEN=ghp_your_token_here
GROQ_API_KEY=gsk_your_groq_key_here

# Optional - enables semantic memory search in Mem0
OPENAI_API_KEY=sk-...

# Auth - set to a strong random string in production
AUTH_SECRET_KEY=change-me-to-a-long-random-string
AUTH_ENABLED=true
AUTH_TOKEN_EXPIRE_MINUTES=60

# Memory decay - remove memories older than this many days
MEMORY_DECAY_DAYS=90
MEMORY_DEDUP_THRESHOLD=0.85

# SQLite path for short-term session persistence
SQLITE_DB_PATH=agent_memory.db

# MCP server URL (default shown)
MCP_SERVER_URL=http://localhost:8001/sse

# CORS - comma-separated origins, or * for dev
CORS_ORIGINS=*
